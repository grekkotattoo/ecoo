# Copia a .env (gitignored) o exporta como variables de entorno. NUNCA subas claves al repo.
# Cerebro creativo vía API (solo si llm.provider=anthropic):
ANTHROPIC_API_KEY=
# Voces vía API (solo si voice.provider=elevenlabs y voice.elevenlabs.enabled=true):
ELEVENLABS_API_KEY=
# Fondos pictóricos opcionales (solo si images.provider=openai):
OPENAI_API_KEY=
# Token opcional para proteger las acciones del panel:
STUDIO_PANEL_TOKEN=
